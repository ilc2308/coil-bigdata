# ============================================================
# COIL Big Data — Variables de Entorno
# Copia este archivo a .env y ajusta los valores.
# NUNCA subas .env a Git.
# ============================================================

# --- Modo de operación ---
# Valores válidos: local | aws
APP_MODE=local

# --- Credenciales de la aplicación web ---
# Usuario y contraseña para el login del dashboard Streamlit
APP_USERNAME=admin
APP_PASSWORD=coil2026

# Clave secreta para firmar los JWT (cambia esto en producción)
JWT_SECRET_KEY=cambia_esta_clave_secreta_en_produccion
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

# --- Rutas locales (modo local) ---
# Directorio raíz del proyecto (se infiere automáticamente si se deja vacío)
LOCAL_BASE_DIR=

# Rutas de los catálogos
LOCAL_CATALOGO_SERVICIOS=dataset/COIL_catalogo_servicios_cubiertos.csv
LOCAL_CATALOGO_PERFILES=dataset/COIL_catalogo_perfiles_cobertura.csv

# Directorio de salida (gold curated, quarantine, metrics)
LOCAL_OUTPUT_DIR=output

# Directorio para uploads temporales
LOCAL_UPLOAD_DIR=uploads

# --- AWS (modo aws) ---
# Credenciales del AWS Academy Learner Lab
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_DEFAULT_REGION=us-east-1

# Nombre del bucket S3 (sin s3://)
S3_BUCKET_NAME=

# Prefijos S3
S3_BRONZE_PREFIX=bronze/solicitudes/
S3_GOLD_PREFIX=gold/curated_solicitudes/
S3_QUARANTINE_PREFIX=quarantine/solicitudes/
S3_CATALOGS_PREFIX=catalogs/
S3_ATHENA_RESULTS_PREFIX=athena-results/

# Nombre del Glue Job
GLUE_JOB_NAME=coil-bigdata-salud-spark-batch-processor

# Nombre del WorkGroup de Athena
ATHENA_WORKGROUP=coil-bigdata-salud-analytics-wg
ATHENA_DATABASE=coil_bigdata_salud_db

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000

# Versión del catálogo de reglas
VERSION_CATALOGO=2026.1
